# Copy this file to .env and fill in your real values.
# This backend is the ONLY place credentials should live — never put them
# in the dashboard's CONFIG block, since that code runs in the browser.

# Port 8000 was already taken by another local service on this machine —
# defaulting to 8001 instead. Change freely if 8001 is also in use for you.
PORT=8001

# Origin of the dashboard dev server, for CORS. Vite's default is 5173.
CORS_ORIGIN=http://localhost:5173

# Shared secret the dashboard must send back (X-API-Key header) on every
# request. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Must match CONFIG.API_KEY in TestManagementDashboard.jsx. Leave blank to
# disable this check (e.g. pure local dev).
BACKEND_API_KEY=

# =============================================================================
# Jira (DEFECT_SOURCE = "jira")
# =============================================================================
# Jira Cloud: https://your-domain.atlassian.net
# Jira Server/Data Center: https://jira.your-company.com
JIRA_BASE_URL=https://your-domain.atlassian.net

# Jira Cloud auth: email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=

# Jira Server/Data Center auth instead: a Personal Access Token, used as a
# Bearer token. If set, this takes priority over email/API token Basic auth.
JIRA_PERSONAL_ACCESS_TOKEN=

# Restrict which issues are pulled. Required.
JIRA_JQL=project = PROJ ORDER BY created DESC

# Jira Cloud tenants: use /rest/api/3/search/jql (Atlassian retired the old
# /rest/api/3/search endpoint — it now 410s). Jira Server/Data Center: use
# the classic /rest/api/3/search instead, since that migration doesn't apply.
JIRA_SEARCH_PATH=/rest/api/3/search/jql

# Custom field IDs are per-instance — find yours via:
# GET {JIRA_BASE_URL}/rest/api/3/field
# Sprint field (Jira Software). Leave blank to skip sprint mapping.
JIRA_SPRINT_FIELD=customfield_10020
# A field (often a text/labels field) your team uses to record linked TC IDs
# (e.g. "TC-001, TC-014"). Leave blank if you don't have one yet.
JIRA_TC_LINK_FIELD=customfield_10050

# =============================================================================
# TestLink (TC_SOURCE = "testlink")
# =============================================================================
# Base URL of your TestLink install (no trailing slash, no /lib/... suffix)
TESTLINK_BASE_URL=https://testlink.your-company.com
# TestLink user profile -> generate a personal API key
TESTLINK_DEV_KEY=
# Comma-separated exact project names to pull suites from. Leave blank to
# pull every project the dev key can see.
TESTLINK_PROJECT_NAME=
# Comma-separated test plan names to pull execution status from (merged
# across all of them, most recent execution per test case wins). Leave
# blank to use every test plan in each targeted project; if a project has
# no test plans at all, its test cases import with status "Not Run".
TESTLINK_TEST_PLAN_NAME=

# TestLink has no built-in "is this automated" flag. We check each test
# case's keywords for this value (case-insensitive) to mark it Automated.
# Leave blank to skip automation detection entirely (-> everything "Manual").
TESTLINK_AUTOMATION_KEYWORD=automated

# Optional custom field name holding the automation script path, if your
# TestLink install tracks one. Leave blank if not applicable.
TESTLINK_SCRIPT_PATH_FIELD=

# =============================================================================
# Other DEFECT_SOURCE options — fill in only the one you actually set
# CONFIG.DEFECT_SOURCE to in TestManagementDashboard.jsx. The rest can stay
# blank; their routes just report "not configured" until you need them.
# =============================================================================

# --- Azure DevOps (DEFECT_SOURCE = "azure_devops") ---
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
# Optional WIQL override. Default: all work items in the project, newest first.
AZURE_DEVOPS_WIQL=
# Optional — Azure DevOps Server (on-prem) base URL. Leave blank for Cloud.
AZURE_DEVOPS_BASE_URL=

# --- Bugzilla (DEFECT_SOURCE = "bugzilla") ---
BUGZILLA_BASE_URL=https://bugzilla.your-company.com
BUGZILLA_API_KEY=
# Optional — restricts to one product. Leave blank to pull all products.
BUGZILLA_PRODUCT=
# Caps how many bugs get pulled, newest-changed-first. Large public trackers
# (e.g. bugzilla.mozilla.org) can have tens of thousands of historical bugs
# with no other scoping — this guards against pulling all of them.
BUGZILLA_MAX_RESULTS=200

# --- Mantis (DEFECT_SOURCE = "mantis") ---
MANTIS_BASE_URL=https://mantis.your-company.com
MANTIS_API_TOKEN=
MANTIS_PROJECT_ID=

# --- GitHub Issues (DEFECT_SOURCE = "github_issues") ---
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
# Optional — GitHub Enterprise Server base URL. Leave blank for github.com.
GITHUB_API_BASE_URL=
# Caps how many issues get pulled, newest-updated-first.
GITHUB_MAX_RESULTS=200

# --- Linear (DEFECT_SOURCE = "linear") ---
LINEAR_API_KEY=
LINEAR_TEAM_KEY=

# =============================================================================
# Other TC_SOURCE options — same rule: fill in only the one matching
# CONFIG.TC_SOURCE.
# =============================================================================

# --- TestRail (TC_SOURCE = "testrail") ---
TESTRAIL_BASE_URL=https://your-domain.testrail.io
TESTRAIL_EMAIL=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=

# --- qTest (TC_SOURCE = "qtest") ---
QTEST_BASE_URL=https://your-domain.qtestnet.com
QTEST_BEARER_TOKEN=
QTEST_PROJECT_ID=
# qTest has no built-in automation flag — checks a custom "Automation" field
# for this value. Leave blank to skip (-> everything "Manual").
QTEST_AUTOMATION_KEYWORD=automated

# --- Zephyr Scale / Jira (TC_SOURCE = "zephyr_scale") ---
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_API_TOKEN=
ZEPHYR_PROJECT_KEY=
# Zephyr Scale has no single canonical automation flag either — checks for
# this label on the test case. Leave blank to skip.
ZEPHYR_AUTOMATION_KEYWORD=automated

# --- PractiTest (TC_SOURCE = "practitest") ---
PRACTITEST_BASE_URL=https://api.practitest.com
PRACTITEST_EMAIL=
PRACTITEST_API_TOKEN=
PRACTITEST_PROJECT_ID=

# --- Kiwi TCMS (TC_SOURCE = "kiwi_tcms") ---
KIWI_BASE_URL=https://kiwi.your-company.com
KIWI_USERNAME=
KIWI_API_TOKEN=
# Optional — restricts to one product. Leave blank to pull everything visible.
KIWI_PRODUCT_NAME=
# Only for local/self-signed HTTPS instances you control (e.g. a Docker
# install on https://localhost) — never enable this against a real
# internet-facing server, since it disables TLS certificate validation.
KIWI_ALLOW_SELF_SIGNED=false
